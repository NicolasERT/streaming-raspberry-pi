# ==============================================================================
# STREAMING RASPBERRY PI — CONFIGURACIÓN POR DEFECTO
# ==============================================================================
# Este archivo contiene todos los parámetros configurables del sistema.
# Se usa como plantilla de valores por defecto. Durante la instalación,
# la configuración elegida se guarda en /etc/streaming-pi/config.env.
#
# Los scripts cargan primero estos defaults y luego aplican los overrides
# del archivo de configuración del sistema si existe.
# ==============================================================================

# --- General ------------------------------------------------------------------
USER_NAME="nicolasrt"

# --- Video --------------------------------------------------------------------
V_DEV="/dev/video0"
SIZE="1920x1080"
FPS="60"
VIDEO_BITRATE="4000k"

# --- Audio --------------------------------------------------------------------
DEV_NAME="USB3.0 Video"
AUDIO_SAMPLE_RATE="44100"
AUDIO_VOLUME="15"

# --- USB ----------------------------------------------------------------------
U_BUS="5-1"

# --- Red / RTMP ---------------------------------------------------------------
RTMP_URL="rtmp://localhost:1935/live/stream"

# --- MediaMTX (puertos) ------------------------------------------------------
RTMP_PORT="1935"
HLS_PORT="8888"
WEBRTC_PORT="8889"
RTSP_PORT="8554"

# --- Monitor térmico ----------------------------------------------------------
TEMP_LIMIT="75"
THERMAL_CHECK_INTERVAL="10"
THERMAL_COOLDOWN="60"

# --- Monitor de inactividad ---------------------------------------------------
IDLE_TIME="300"
IDLE_CHECK_INTERVAL="30"

# --- Home Assistant ------------------------------------------------------------
HA_BASE_URL="http://localhost:8123"
HA_TOKEN_FILE="/etc/ha-token"
HA_ENTITIES="scene.subir_canal_tv,scene.bajar_canal_tv,scene.arriba_tv,scene.abajo_tv,scene.izquierda_tv,scene.derecha_tv,scene.guia_tv,scene.ok_tv,scene.idioma_tv,scene.subtitulos_tv"

# --- Cockpit ------------------------------------------------------------------
COCKPIT_PLUGIN_DIR="$HOME/.local/share/cockpit/pi-tv"

# --- Servicio objetivo (para monitores) ---------------------------------------
MONITOR_SERVICE="streaming-tv.service"
